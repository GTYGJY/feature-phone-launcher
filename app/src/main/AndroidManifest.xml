<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 基础权限 -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 【修改】Android 13+ 显示前台服务常驻通知需要该权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 【修改】1.2.2 起「防护模式」改为纯文字提示页，软件不再调节铃声音量，
         因此移除 MODIFY_AUDIO_SETTINGS 权限（缩小权限面） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 设备管理员权限 -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN" />
    <!-- 联网相关权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 位置权限（仅天气使用粗略定位） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 【修改】以下权限原本声明但代码从未使用，已移除以缩小攻击面：
         SEND_SMS / WRITE_CONTACTS（都通过系统 Intent 完成，不需要本应用持有）、
         DISABLE_KEYGUARD、WAKE_LOCK、ACCESS_FINE_LOCATION（天气只用粗略定位）。 -->

    <!-- 【新增】应用内部广播权限：只允许同签名的广播送达，
         防止第三方应用伪造「新短信」广播给本应用（此前该广播无任何权限保护）。 -->
    <permission
        android:name="com.featurephone.launcher.permission.INTERNAL_BROADCAST"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.featurephone.launcher.permission.INTERNAL_BROADCAST" />


    <application
        android:name=".FeaturePhoneApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="功能机模式"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FeaturePhone"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- 主界面 - 功能机桌面 -->
        <activity
            android:name=".MainActivity"
            android:label="功能机模式"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.FeaturePhone.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 【修改】独立的拨号界面已移除：拨号状态集成在主界面（MainActivity）内，
             由数字键、左软键「电话」菜单项、以及物理拨打键直接进入，
             因此这里不再声明 .apps.DialerActivity，避免出现两套拨号界面。 -->

        <!-- 短信界面 -->
        <activity
            android:name=".apps.MessagesActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity" />

        <!-- 通话记录界面 -->
        <activity
            android:name=".apps.CallLogActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity" />

        <!-- 软件列表界面 -->
        <activity
            android:name=".apps.AppListActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".apps.ColorSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".apps.SettingsActivity" />
        <activity
            android:name=".apps.DisplaySettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".apps.SettingsActivity" />
        <activity
            android:name=".apps.OtherSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".apps.SettingsActivity" />
        <activity
            android:name=".apps.NetworkSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".apps.SettingsActivity" />
        <activity
            android:name=".apps.NetworkExplainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".apps.NetworkSettingsActivity" />
        <activity
            android:name=".apps.LanguageUnitSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".apps.SettingsActivity" />
        <activity
            android:name=".apps.UnitSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".apps.LanguageUnitSettingsActivity" />
        <activity
            android:name=".apps.AdminExplainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".apps.OtherSettingsActivity" />
        <activity
            android:name=".apps.BackgroundAppManagerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".apps.OtherSettingsActivity" />
        <activity
            android:name=".apps.ProtectionSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".apps.SettingsActivity" />
        <activity
            android:name=".apps.NotificationManagerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".apps.SettingsActivity" />

        <!-- 联系人界面 -->
        <activity
            android:name=".apps.ContactsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity" />

        <!-- 设置界面 -->
        <activity
            android:name=".apps.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity" />

        <!-- 关于界面 -->
        <activity
            android:name=".apps.AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity" />

        <!-- 免责声明同意界面 -->
        <activity
            android:name=".apps.DisclaimerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- 常驻前台服务 -->
        <service
            android:name=".FeaturePhoneService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Feature phone mode kiosk service" />
        </service>

        <!-- 设备管理员接收器 -->
        <receiver
            android:name=".DeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- 开机自启动 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 短信接收 -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>


    <!-- Android 11+ 包可见性：允许查看所有已安装应用 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

</manifest>
